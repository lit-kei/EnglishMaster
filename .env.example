# Copy to .env. Never commit your API key.
# Local AI: install Ollama, then run: ollama pull qwen3:4b
# No API key is needed. Use a downloaded LOCAL model.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Cloud alternatives: explicitly set AI_PROVIDER=gemini or openai.
# Gemini API requires users to be 18 or older.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
HOST=127.0.0.1
# Required when exposing an AI-enabled server on 0.0.0.0.
# Use a long, unique password. Visitors enter it in the site.
APP_PASSWORD=
# On a deployed server, set the exact HTTPS origin (no trailing slash).
PUBLIC_ORIGIN=
# Optional: 32+ character secret, keeps question/session tokens valid after restart.
TOKEN_SECRET=
