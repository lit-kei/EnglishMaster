# Copy to .env. Never commit your API key.
# Get a key at https://aistudio.google.com/apikey (use a Free Tier project).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional paid provider: explicitly set AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
HOST=127.0.0.1
# Required when exposing an AI-enabled server on 0.0.0.0.
# Use a long, unique password. Visitors enter it in the site.
APP_PASSWORD=
# On a deployed server, set the exact HTTPS origin (no trailing slash).
PUBLIC_ORIGIN=
# Optional: 32+ character secret, keeps question/session tokens valid after restart.
TOKEN_SECRET=
